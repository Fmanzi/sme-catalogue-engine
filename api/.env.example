# API Server Configuration
API_PORT=3001
JWT_SECRET=change-this-in-production

# Cloudflare Pages deploy hook (optional)
# CF_DEPLOY_HOOK=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/YOUR_HOOK_ID

# ---- Free publish-to-live loop ----
# Every admin save rebuilds the bundle and pushes changed client data +
# processed images to git, so Cloudflare Pages auto-rebuilds the live site.
# All of this is free (GitHub + Cloudflare free tiers).
#
# GitHub token with "Contents: Read and write" on THIS repo only (fine-grained).
# Make one at: GitHub -> Settings -> Developer settings -> Fine-grained tokens
# GIT_PAT=github_pat_xxx
# GIT_BRANCH=main
# GIT_USER=Anon Store Admin
# GIT_EMAIL=admin@anon-store.local
# REBUILD_PUSH=1          # set REBUILD_PUSH=0 to disable auto-push
